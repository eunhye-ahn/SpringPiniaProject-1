<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.web.mapper.RecipeMapper">
	<!-- 목록 
	Mapper 연결 
	id = 메소드명
	resultType = return
	parameterType = 매개변수
	public List<RecipeVO> recipeListData(int start)
	
	include 쓰는 방법
	-->
	<select id="recipeListData" resultType="com.sist.web.vo.RecipeVO" parameterType="int">
		SELECT no,title,chef,poster
		FROM recipe
		ORDER BY no ASC
		offset #{start} ROWS FETCH NEXT 12 ROWS ONLY 
	</select>
	<!-- count -->
	<select id="recipeCount" resultType="int">
		SELECT COUNT(*)
		FROM recipe
	</select>
	
	<!-- 상세보기 -->
	
	<!-- 검색(P) -->
</mapper>